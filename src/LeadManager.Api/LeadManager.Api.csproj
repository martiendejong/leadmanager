<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Single source of truth is the repo-root VERSION file; scripts/bump-version.ps1 keeps
         this in sync with it. Read at runtime via Assembly.GetName().Version for /api/health. -->
    <Version>1.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.*" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.4.1" />
    <PackageReference Include="EPPlus" Version="7.*" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.*" />
    <PackageReference Include="Hangfire.MemoryStorage" Version="1.8.*" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.*" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.*" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Core" Version="1.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.*" />
    <PackageReference Include="PdfPig" Version="0.1.13" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.*" />
    <!-- Force .NET 8.0 versions to prevent version conflicts with WebSearch multi-targeting -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The versioned prompt of the lead hunt agent: rendered into the JengoWork task. -->
    <EmbeddedResource Include="..\..\docs\hunt\AGENT_PROMPT.md" LogicalName="AGENT_PROMPT.md" />
    <!-- The product catalog the hunt agent chooses from, and the keys a lead may name: one file. -->
    <EmbeddedResource Include="Agent\PRODUCTS.md" />
    <!-- Seeded organisation memberships (people by e-mail): applied once per pair at start. -->
    <EmbeddedResource Include="..\..\deploy\org_members.json" LogicalName="org_members.json" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Default keeps the Windows layout. The Docker build passes -p:WebSearchProject=/src/websearch/... -->
    <WebSearchProject Condition="'$(WebSearchProject)' == ''">E:\projects\websearch\WebSearch\WebSearch.csproj</WebSearchProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(WebSearchProject)" Properties="TargetFramework=net8.0" />
  </ItemGroup>

</Project>
