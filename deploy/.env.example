# Jengo Clients · omgevingsinstellingen. Kopieer naar .env in de deploy-map op de server en vul in.
# .env komt NOOIT in git; echte waarden staan in de vault.

# test | acc | prod  (bepaalt de naam van de stack en de netwerk-alias <prefix>-clients)
ENV_PREFIX=test
# Publieke URL van deze omgeving, zonder slash aan het eind (CORS en SSO-callback).
PUBLIC_URL=https://clients-test.martiendejong.nl
# Extern Docker-netwerk van de Caddy-gateway op deze server (test/acc: proxy_net, prod: maaride_net).
GATEWAY_NETWORK=proxy_net
# Harde geheugengrens van de container.
MEM_LIMIT=768m

# Geheimen: per omgeving uniek en sterk (JWT_KEY minimaal 32 willekeurige tekens). Nooit hergebruiken.
JWT_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin

# SSO met Jengo IAM. Standaard de productie-IAM; op test/acc is lokaal inloggen genoeg.
# De callback <PUBLIC_URL>/api/auth/sso/callback moet bij de IAM-client geregistreerd zijn.
SSO_ISSUER=https://maendeleo.martiendejong.nl
SSO_CLIENT_ID=leadmanager

# Optioneel (leeg = functie uit; op test bewust leeg zodat er niets naar echte diensten gaat)
OPENAI_API_KEY=
GOOGLE_PLACES_API_KEY=
JENGOWORK_BASE_URL=
JENGOWORK_API_KEY=
MINOX_POC_BASE_URL=
