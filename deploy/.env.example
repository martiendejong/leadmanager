# Jengo Clients · environment settings. Copy to .env in the deploy folder on the server and fill in.
# .env NEVER goes in git; real values live in the vault.

# test | acc | prod  (determines the stack name and the network alias <prefix>-clients)
ENV_PREFIX=test
# Public URL of this environment, without trailing slash (CORS and SSO callback).
PUBLIC_URL=https://clients-test.martiendejong.nl
# External Docker network of the Caddy gateway on this server (test/acc: proxy_net, prod: maaride_net).
GATEWAY_NETWORK=proxy_net
# Hard memory limit of the container.
MEM_LIMIT=768m

# Secrets: unique and strong per environment (JWT_KEY at least 32 random characters). Never reuse.
JWT_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin

# SSO with Jengo IAM. Production IAM by default; on test/acc local login is enough.
# The callback <PUBLIC_URL>/api/auth/sso/callback must be registered with the IAM client.
SSO_ISSUER=https://maendeleo.martiendejong.nl
SSO_CLIENT_ID=leadmanager

# Optional (empty = feature off; deliberately empty on test so nothing goes to real services)
# OPENAI_API_KEY also switches on the AI help in the message section (regenerate a message, demo ideas). Empty = "AI is not configured" there; templates keep working.
OPENAI_API_KEY=
# Optional model id for that AI help (empty = built-in default, a current id from CURRENT_MODELS.md)
AI_COMPOSE_MODEL=
GOOGLE_PLACES_API_KEY=
JENGOWORK_BASE_URL=
JENGOWORK_API_KEY=
MINOX_POC_BASE_URL=

# Fedha invoice sync (read-only). Empty FEDHA_API_KEY = off. The key lives in the vault (project 9), never in git.
FEDHA_BASE_URL=https://fedha.martiendejong.nl/api
FEDHA_API_KEY=
FEDHA_SYNC_USER_EMAIL=

# Lead hunt (Find new leads): a background Jengo agent does the research. See docs/agent/LEAD_HUNT.md and docs/hunt/AGENT_PROMPT.md.
# The app creates a JengoWork task on board 105 "Jengo Clients" (JENGOWORK_BASE_URL + JENGOWORK_API_KEY above). Empty board = 105.
# Every hunt gets its own random token, stored hashed, valid 3 hours; nothing to configure for it.
HUNT_DISPATCH_BOARD_ID=
HUNT_DISPATCH_STATUS=
# Who may start a hunt, comma separated. Empty = administrators only.
HUNT_ALLOWED_EMAILS=

# Jengo Track (click tracking). Off unless TRACK_ENABLED=true. Webhook: POST {PUBLIC_URL}/api/integrations/track/webhook
TRACK_ENABLED=false
TRACK_BASE_URL=
TRACK_API_KEY=
TRACK_WEBHOOK_SECRET=
TRACK_HOT_THRESHOLD=2
