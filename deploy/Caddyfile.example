# Jengo Clients blocks for the shared Caddy gateway. upload_and_deploy.py puts them into the Caddyfile
# itself with `gateway <env>` (with backup and validation). Manual is also possible: paste the environment's block
# into the gateway's Caddyfile on that server and reload Caddy
# (docker exec <caddy> caddy reload --config /etc/caddy/Caddyfile).
# Caddy handles the certificates itself once the DNS record points to the server.
#
# Note: the Caddyfile is mounted as a single file in the container: edit it on the host IN PLACE
# (no `sed -i`, which creates a new file the container does not see) or restart the gateway afterwards.

# --- test/acc server (46.224.114.149, gateway /opt/jengo-gateway) ---
clients-test.martiendejong.nl {
    encode zstd gzip
    reverse_proxy test-clients:8080 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }
}

clients-acc.martiendejong.nl {
    encode zstd gzip
    reverse_proxy acc-clients:8080 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }
}

# --- production server (46.62.219.14, gateway /opt/maaride-gateway) ---
clients.prospergenics.com, api.leads.prospergenics.com {
    encode zstd gzip
    reverse_proxy prod-clients:8080 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }
}

leads.prospergenics.com {
    redir https://clients.prospergenics.com{uri} 308
}
